#!/usr/bin/env bash
# DevPilot CLI runner
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$SCRIPT_DIR/backend"

if [ -f "$BACKEND_DIR/.venv/bin/python" ]; then
    PYTHON_EXEC="$BACKEND_DIR/.venv/bin/python"
else
    PYTHON_EXEC="python3"
fi

cd "$BACKEND_DIR" || exit 1
exec "$PYTHON_EXEC" -m app.cli "$@"
