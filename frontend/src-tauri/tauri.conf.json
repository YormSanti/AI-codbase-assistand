{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IFROG",
  "version": "1.5.0",
  "identifier": "com.ifrog.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IFROG",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/backend/": "backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/YormSanti/AI-codbase-assistand/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwMkJEM0Q0M0U0RTJFRDMKUldUVExrNCsxTk1yRUN5eitVTjRRMTk5S0hzQ0lvTnV2Ky9PZ1g4d1IzblVOTEphdnNEeEJDajQK"
    }
  }
}
