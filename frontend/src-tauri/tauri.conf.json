{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevPilot AI",
  "version": "0.1.0",
  "identifier": "ai.devpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevPilot AI",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/devpilot-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
